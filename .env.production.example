# ==============================================================================
# TOKENPOOL — PRODUCTION CONFIGURATION TEMPLATE
# DO NOT COMMIT ACTUAL SECRETS OR KEYS TO VERSION CONTROL.
# This file contains placeholders only. Copy to .env or supply via your
# production container / orchestration secret manager.
# ==============================================================================

# Core Database Configuration (External persistent PostgreSQL instance)
DATABASE_URL=<PRODUCTION_POSTGRES_URL>

# Cryptographic Security Secrets (Must be generated independently for production)
JWT_SECRET=<GENERATE_RANDOM_PRODUCTION_SECRET>
FERNET_KEY=<GENERATE_RANDOM_FERNET_KEY>

# Mode Settings (Strictly disabled in production)
DEMO_MODE=false
ENVIRONMENT=production

# CORS Configuration (Must be set strictly to the deployed domain; no wildcards or localhost)
CORS_ORIGINS=https://<PRODUCTION_DOMAIN>

# Platform Commission
COMMISSION_RATE=0.20

# Payment Gateway Configuration
REQUIRE_PAYMENT_GATEWAY=true
PAYMENT_WEBHOOK_SECRET=<GENERATE_RANDOM_WEBHOOK_SECRET>

# Optional TokenPool Platform API Keys (Fallback / Platform capacity only)
GEMINI_API_KEY=<OPTIONAL_PROVIDER_OR_PLATFORM_KEY>
OPENAI_API_KEY=<OPTIONAL_PROVIDER_OR_PLATFORM_KEY>
ANTHROPIC_API_KEY=<OPTIONAL_PROVIDER_OR_PLATFORM_KEY>

# Delegated Plan Settings (Disabled by default until officially approved)
OPENAI_DELEGATED_PLAN_ENABLED=false
OPENAI_PARTICIPATING_APP_STATUS=unregistered
